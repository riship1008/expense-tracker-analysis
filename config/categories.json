{
  "_comment": "Maps the bank's Czech transaction codes to English categories. A rule matches on any of: type, operation, k_symbol (the payment purpose code). First match wins, so specific rules come first. Cash withdrawals and transfers out carry no purpose code, so they get their own group instead of being guessed.",
  "translations": {
    "type": {"PRIJEM": "credit", "VYDAJ": "debit", "VYBER": "withdrawal"},
    "operation": {
      "VYBER KARTOU": "card purchase", "VKLAD": "cash deposit", "PREVOD Z UCTU": "transfer in",
      "VYBER": "cash withdrawal", "PREVOD NA UCET": "transfer out"
    },
    "k_symbol": {
      "POJISTNE": "insurance", "SLUZBY": "statement fee", "UROK": "interest credited",
      "SANKC. UROK": "penalty interest", "SIPO": "household bills", "DUCHOD": "pension", "UVER": "loan payment"
    },
    "frequency": {"POPLATEK MESICNE": "monthly", "POPLATEK TYDNE": "weekly", "POPLATEK PO OBRATU": "after each transaction"}
  },
  "rules": [
    {"category": "Pension",          "group": "Income",           "k_symbol": "DUCHOD"},
    {"category": "Interest Earned",  "group": "Income",           "k_symbol": "UROK"},
    {"category": "Transfers In",     "group": "Income",           "operation": "PREVOD Z UCTU"},
    {"category": "Cash Deposits",    "group": "Income",           "operation": "VKLAD"},
    {"category": "Penalty Interest", "group": "Avoidable",        "k_symbol": "SANKC. UROK"},
    {"category": "Bank Fees",        "group": "Avoidable",        "k_symbol": "SLUZBY"},
    {"category": "Household Bills",  "group": "Essential",        "k_symbol": "SIPO"},
    {"category": "Insurance",        "group": "Essential",        "k_symbol": "POJISTNE"},
    {"category": "Loan Payments",    "group": "Essential",        "k_symbol": "UVER"},
    {"category": "Card Purchases",   "group": "Discretionary",    "operation": "VYBER KARTOU"},
    {"category": "Cash Withdrawals", "group": "Cash & Transfers", "operation": "VYBER"},
    {"category": "Transfers Out",    "group": "Cash & Transfers", "operation": "PREVOD NA UCET"}
  ]
}
